# Banco de dados Neon (Postgres)
DATABASE_URL=postgresql://usuario:senha@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Cloudflare R2 (compatível com S3)
R2_ACCOUNT_ID=seu_account_id
R2_ACCESS_KEY_ID=sua_access_key
R2_SECRET_ACCESS_KEY=sua_secret_key
R2_BUCKET_NAME=tenax-indoor
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Admin (login do painel)
ADMIN_EMAIL=admin@tenax.com
ADMIN_PASSWORD=senha_segura_aqui

# Segredo para sessão Next-Auth (gere com: openssl rand -base64 32)
NEXTAUTH_SECRET=segredo_aleatorio_longo
NEXTAUTH_URL=http://localhost:3000
